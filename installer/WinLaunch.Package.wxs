<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="WinLaunch"
    Manufacturer="WinLaunch"
    Version="$(var.ProductVersion)"
    UpgradeCode="A7C4E2F1-8B3D-4A9E-9F6C-1D2E3F4A5B6C"
    Scope="perUser"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of WinLaunch is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Files Include="$(var.PublishDir)\**" />
  </Package>
</Wix>
